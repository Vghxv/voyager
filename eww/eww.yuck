(include "var.yuck")
(include "utils.yuck")
(include "sound.yuck")
(include "power_menu.yuck")
(include "popup.yuck")

; https://docs.rs/chrono/latest/chrono/format/strftime/index.html
(defwidget w_time [class format]
  (button 
    :class class "${formattime(EWW_TIME, format)}")
  )

(defwidget w_systray []
  (systray 
    :icon-size 20
    :spacing 10
    )
  )

(defwidget w_camera []
  (tbutton 
    :var camera 
    :value_on "On"
    :text_on "📸"
    :text_off "📷" 
    :color_on "camera_on" 
    :color_off "element" 
    :cmd "EWW='${EWW_EXECUTABLE}' ${EWW_CONFIG_DIR}/scripts/webcam.sh toggle"
    )
  )


(defwidget w_battery []
 (inp
    :class {EWW_BATTERY?.[BAT_NAME]?.status != "Discharging" ? "bat-charging" :
     EWW_BATTERY?.[BAT_NAME]?.capacity < 25 ? "bat-low" :
     EWW_BATTERY?.[BAT_NAME]?.capacity < 50 ? "bat-mid" : "element" }
    :filename "battery.png"
    :text "${EWW_BATTERY?.[BAT_NAME]?.capacity}%"
    :tooltip "${battery_estimate}"
  )
)

(defwidget w_brightness [class]
  (inp
    :class class
    :filename "brightness.png"
    :text "${brightness}%"
  )
)

(defwidget w_wifi []
  (inp
    :class {wifi_name != '' ? "wifi-connected" : "wifi-disconnected"}
    :filename "wifi.png"
    :text "${wifi_name != '' ? wifi_name : 'Disconnected'}"
  )
)

; left click: volume/mic popup (sound.yuck) on this monitor; right click: pavucontrol
(defwidget w_volctl [class monitor]
  (button 
    :class class 
    :onclick "EWW='${EWW_EXECUTABLE}' ${EWW_CONFIG_DIR}/scripts/popup.sh sound '${monitor}'"
    :onrightclick "sh -c 'pavucontrol &'"
    (bimage 
      :filename "sound-wave.png")
    )
  )

(defwidget w_sound [class]
    (box
      :class class
      (scale
        :min 0
        :max 101
        :scroll-amount volume_scroll_amount
        :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%"
        :value {volume == "Muted" || volume == "" ? 0 : volume}
        )
      )
  )


(defwidget cBoxStart [monitor]
  (box :space-evenly false
       :spacing 10
    (button
      :class "element menu-button"
      :onclick "EWW='${EWW_EXECUTABLE}' ${EWW_CONFIG_DIR}/scripts/popup.sh power_menu '${monitor}'"
      (bimage :filename "menu-burger.png")
      )
    (cell :width 80 (w_time :class "element" :format "%R"))
    (cell :width 80 (w_time :class "element" :format "%a %v"))
    (box 
      :class "btn-ws"
      :spacing 10
      (for ws in "${workspace_state?.workspaces}"
        (button 
          :onclick "${EWW_CONFIG_DIR}/scripts/workspace.sh ${ws}"
          :class {ws == (workspace_state?.monitors?.[monitor] ?: workspace_state.active) ? "active" : "inactive"}
          "${ws}"
          )
        )
      )
    )
  )

(defwidget cBoxEnd [monitor]
  (box 
    :spacing 10 
    :space-evenly false 
    :halign "end"
    (cell :width 80 (w_wifi))
    (cell :width 100 (w_sound :class "sound"))
    (cell :width 40 (w_volctl :class "element" :monitor monitor))
    (cell :width 80 (w_brightness :class "element"))
    (cell :width 40 (w_camera))
    (box
      :width 80
      :visible {BAT_NAME != ""}
      (w_battery)
      )
    (box
      :class "systray"
      (w_systray)
      )
    )
  )

; One bar per monitor: scripts/bars.sh opens `bar --id bar-<name> --arg monitor=<name>`.
(defwindow bar [monitor]
  :monitor monitor
  :geometry
  (geometry
    :x "0px"
    :y "0px"
    :width "100%"
    :height "3%"
    :anchor "top center"
    )
  :stacking "fg"
  :exclusive true
  :focusable "none"
  ; rebuilt on every light/dark switch, see utils.yuck
  (box (literal :content "(bar_body :mode \"${theme}\" :monitor \"${monitor}\")"))
  )

; class = light|dark: eww.scss scopes every rule under it
(defwidget bar_body [mode monitor]
  (box :class mode
    (centerbox
      (cBoxStart :monitor monitor)
      (box)
      (cBoxEnd :monitor monitor)
      )
    )
  )
