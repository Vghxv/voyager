(include "audio/audio_ctl.yuck")

(defwindow sound
  :monitor "[1,0]"
  :geometry 
  (
   geometry 
   :x "282px"
   :y "10px"
   :width "5%"
   :anchor "top right"
   )
  :stacking "fg"
  :focusable "none"
  (box (literal :content "(sound_body :mode \"${theme}\")"))
  )

(defwidget sound_body [mode]
  (box :orientation "h" :class mode
    (audio-control
      :device-type "SINK"
      :icon "🔊"
      :current-value volume
      :class "element")
    (audio-control
      :device-type "SOURCE"
      :icon "🎙️"
      :current-value mic
      :class "element")
    )
  )
