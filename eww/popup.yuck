; Invisible window under an open popup (scripts/popup.sh): a click outside the
; popup lands here and closes it. It stops at the bar (the bar's exclusive zone).
(defwindow popup_closer
  :monitor "[1,0]"
  :geometry (geometry :width "100%" :height "100%" :anchor "top left")
  :stacking "fg"
  :focusable "none"
  (eventbox :onclick "${EWW_CMD} close sound power_menu popup_closer"))
