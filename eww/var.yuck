; VAR — the only machine-specific setting
(defvar BAT_NAME "BAT0")        ; battery key in EWW_BATTERY: ls /sys/class/power_supply

; Script paths are relative to the eww config folder.

; BRIGHTNESS
(deflisten brightness :initial "" "scripts/brightness.sh")

; VOLUME
(deflisten volume :initial "" "scripts/vol.sh")

; MIC
(deflisten mic :initial "" "scripts/mic.sh")

; CAMERA (webcam USB port is set in scripts/webcam.sh)
(defpoll camera :interval "0.5s" "scripts/webcam.sh status")

; WIFI: name of the active wireless connection, whatever the interface is called
(defpoll wifi_name :interval "10s"
  `nmcli -t -f NAME,TYPE connection show --active | awk -F: '$2 == "802-11-wireless" { print $1; exit }'`)

; WORKSPACES
(deflisten workspace_state :initial '{"workspaces":[],"active":0}' "scripts/workspaces.sh")

; BATTERY ESTIMATE
(defpoll battery_estimate :interval "60s" "scripts/battery_estimate.sh")
