; IMAGE HELPER
(defwidget bimage [filename]
  (image :path "${EWW_CONFIG_DIR}/assets/${theme}/${filename}" :halign "center" :image-width "20" :image-height "20")
  )

(defwidget tbutton [var value_on text_on text_off color_on color_off cmd]
  (button
    :class {var == value_on ? color_on : color_off}
    :onclick cmd
    "${var == value_on ? text_on : text_off}"
    )
  )

(defwidget inp [class filename text ?tooltip]
  (box
    :space-evenly false
    :class class
    (box
      :width 40
      (bimage 
        :filename filename)
      )
    (box
      (label :text text
             :tooltip tooltip)
      )
    )
  )

(defwidget power_menu []
  (box
    :class "power-menu"
    :orientation "v"
    :space-evenly false
    :spacing 5
    (button
      :class "menu-item suspend"
      :onclick "systemctl suspend"
      "Suspend"
      )
    (button
      :class "menu-item reboot"
      :onclick "reboot"
      "Reboot"
    )
    (button
      :class "menu-item shutdown"
      :onclick "shutdown now"
      "Shutdown"
      )
    )
  )


; LIGHT / DARK: every window's content is a `literal` whose text contains the
; mode, e.g. "(bar_body :mode \"dark\" ...)". A mode change gives new text, so eww
; builds a fresh widget tree with the right class from the start. Swapping the
; class on a live widget instead does not reliably restyle the cells inside it:
; some bars kept the old colors.
