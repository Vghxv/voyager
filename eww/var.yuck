; Bar state. Script paths are relative to the eww config folder.
; A script that cannot work (missing package, no device) says why in `eww logs`.

; key of the system battery in EWW_BATTERY (BAT0, CMB0, ...); "" hides the battery cell
(defpoll BAT_NAME :interval "1h" :initial "" "scripts/battery_name.sh")
(defpoll battery_estimate :interval "60s" "scripts/battery_estimate.sh")

; brightness in %, "" without a backlight
(deflisten brightness :initial "" "scripts/brightness.sh")

; volume 0-100 or "Muted"
(deflisten volume :initial "" "scripts/audio.sh sink")
(deflisten mic :initial "" "scripts/audio.sh source")

; webcam On/Off (device is detected, see scripts/webcam.sh)
(defpoll camera :interval "0.5s" "scripts/webcam.sh status")

; active wifi network, "" when offline
(defpoll wifi_name :interval "10s" "scripts/wifi.sh")

; {"workspaces":[...],"active":N,"monitors":{name: N}}
(deflisten workspace_state :initial '{"workspaces":[],"active":0}' "scripts/workspaces.sh")

; light | dark: read from voyager's saved mode at start; voyager-theme updates it
; live through its eww hook. See eww.scss for how it restyles.
(defpoll theme :interval "1h" :initial "light" "cat ~/.config/voyager/theme 2>/dev/null || echo light")
