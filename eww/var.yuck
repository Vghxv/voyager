; BATTERY: key of the system battery in EWW_BATTERY (BAT0, BAT1, ...); "" without one
(defpoll BAT_NAME :interval "1h" :initial "" "scripts/battery_name.sh")

; Script paths are relative to the eww config folder.

; BRIGHTNESS
(deflisten brightness :initial "" "scripts/brightness.sh")

; VOLUME
(deflisten volume :initial "" "scripts/vol.sh")

; MIC
(deflisten mic :initial "" "scripts/mic.sh")

; CAMERA (webcam USB port is set in scripts/webcam.sh)
(defpoll camera :interval "0.5s" "scripts/webcam.sh status")

; WIFI: name of the active wireless connection (NetworkManager, else iw)
(defpoll wifi_name :interval "10s" "scripts/wifi.sh")

; WORKSPACES
(deflisten workspace_state :initial '{"workspaces":[],"active":0}' "scripts/workspaces.sh")

; BATTERY ESTIMATE
(defpoll battery_estimate :interval "60s" "scripts/battery_estimate.sh")

; THEME: light or dark. It is the class of every window's root box (eww.scss scopes
; all rules under .light / .dark) and picks the icon set (assets/<theme>/).
; voyager-theme saves the mode to ~/.config/voyager/theme and sets this var with
; `eww update theme=…`: an instant restyle, no reload.
(defpoll theme :interval "1h" :initial "light" "cat ~/.config/voyager/theme 2>/dev/null || echo light")
