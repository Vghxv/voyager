# voyager — dunst notifications, HUD style
# Layout and behaviour only. Colors are in themes/light.conf and themes/dark.conf;
# the active one is copied to dunstrc.d/90-voyager-theme.conf, read after this file.
# Docs: dunst/dunst.md

[global]
    monitor = 0
    follow = mouse

    # ---------- geometry ----------
    width = 340
    height = (0, 300)
    origin = top-right
    offset = (10, 50)          # below the eww bar: raise the 50 if your bar is taller
    scale = 0
    notification_limit = 6
    gap_size = 6
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 12
    frame_width = 1
    corner_radius = 0
    separator_height = 0
    transparency = 0

    # ---------- progress bar (notify-send -h int:value:NN) ----------
    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 316
    progress_bar_corner_radius = 0

    # ---------- text ----------
    font = GeistMono Nerd Font, JetBrains Mono, monospace 10
    line_height = 0
    markup = full
    format = "<span letter_spacing='1200'><b>▸ %s</b></span>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = end
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    indicate_hidden = yes
    sort = yes

    # ---------- icons ----------
    enable_recursive_icon_lookup = true
    icon_theme = Adwaita
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_corner_radius = 0

    # ---------- behaviour ----------
    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    ignore_dbusclose = false
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_current
    mouse_right_click = close_all
