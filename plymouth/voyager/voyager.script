# =====================================================================
#  voyager  -  Plymouth LUKS unlock screen
#  the voyager sky + warp and blue shift on typing, red shift on
#  backspace + signal pulses + wrong-pass shake
# =====================================================================

# ---------------- tunables ----------------
NUM_STARS   = 55;     # warp stars (only seen while moving)
KEY_BOOST   = 1.4;    # warp burst per typed character
BACK_PULL   = 1.0;    # reverse pull per backspace
WARP_MAX    = 6;      # warp speed after Enter
WARP_SEEN   = 0.6;    # speed at which the warp stars are fully visible
STAR_MIN    = 8;      # smallest warp star, in pixels
STAR_MAX    = 14;     # largest warp star, in pixels
STAR_STEP   = 2;      # star sizes go up in these steps (each size's tails are made at start-up)
STAR_BRIGHT = 0.7;    # dimmest warp star's brightness (the brightest is 1)
BLUE_AT     = 1.4;    # speed at which the sky is fully blue-shifted
RED_AT      = 0.8;    # reverse speed at which it is fully red-shifted
SHIFT_HOLD  = 0.979;  # how slowly the shift fades after the stars stop (per frame)
STREAK_LEN  = 6;      # longest tail, in star sizes
ANGLES      = 48;     # tail directions, turned once at start-up
TRAIL       = 8;      # a tail is as long as its star moves in this many frames (motion blur)
TAIL_THICK  = 0.3;    # tail thickness, as a share of its star's size
TAIL_EASE   = 0.2;    # how fast a tail grows or shrinks towards that (per frame): head first, tail after
CORE_FADE   = 0.25;   # stars dim inside this radius (fraction of screen height)
CORE_VANISH = 0.08;   # ...and vanish inside this one while pulled back
INFLOW      = 1.6;    # backing off: share of stars sent to the edges, per unit of speed per second
LEAVE_STEP  = 0.1;    # ...each fading out at this much per frame first (10 frames)
SHAKE_PX    = 6;      # wrong passphrase: how far the probe shakes, in pixels
SHAKE_DECAY = 0.85;   # ...and how fast it settles (per frame: 0.85 is about 0.25 s)

# Polaris's top-left corner in sky.png, as fractions of its size.
# Written by src/gen-plymouth.py: do not edit by hand.
POLARIS_X = 0.699479;
POLARIS_Y = 0.571296;

# ---------------- background ----------------
# shown only if sky.png is missing
Window.SetBackgroundTopColor(0.08, 0.08, 0.12);
Window.SetBackgroundBottomColor(0.02, 0.02, 0.05);

W  = Window.GetWidth();
H  = Window.GetHeight();
cx = W / 2;
cy = H / 2;
core_fade_r   = CORE_FADE * H;
core_vanish_r = CORE_VANISH * H;
# 60 frames a second, matching a 60 Hz panel: at 50 every fifth frame shows
# twice, which makes fast warp stars judder. Per-frame steps below are for 60.
FPS = 60;
DT  = 1 / FPS;
t  = 0;

fun clamp01(v) {
  if (v < 0) { return 0; }
  if (v > 1) { return 1; }
  return v;
}

# ---------------- the voyager sky (src/gen-plymouth.py) ----------------
# Every layer is the same size: scale it to cover the screen, centred.
sky_src = Image("sky.png");
sky_s = W / sky_src.GetWidth();
if (H / sky_src.GetHeight() > sky_s) {
  sky_s = H / sky_src.GetHeight();
}
sky_w = Math.Int(sky_src.GetWidth() * sky_s + 0.5);
sky_h = Math.Int(sky_src.GetHeight() * sky_s + 0.5);
sky_x = (W - sky_w) / 2;
sky_y = (H - sky_h) / 2;

fun sky_layer(file, z) {
  img = Image(file);
  if (global.sky_s != 1) {
    img = img.Scale(global.sky_w, global.sky_h);
  }
  sp = Sprite(img);
  sp.SetPosition(global.sky_x, global.sky_y, z);
  return sp;
}

sky_sprite  = sky_layer("sky.png", -100);
blue_sprite = sky_layer("blueshift.png", -80);
red_sprite  = sky_layer("redshift.png", -80);
blue_sprite.SetOpacity(0);
red_sprite.SetOpacity(0);

# Polaris on its own small sprite, so its breathing redraws only its corner
polaris_img = Image("polaris.png");
if (sky_s != 1) {
  polaris_img = polaris_img.Scale(polaris_img.GetWidth() * sky_s, polaris_img.GetHeight() * sky_s);
}
polaris_sprite = Sprite(polaris_img);
polaris_sprite.SetPosition(sky_x + POLARIS_X * sky_w, sky_y + POLARIS_Y * sky_h, -90);

speed     = 0;
stars_hidden = 0;
shift     = 0;        # Doppler envelope: follows speed, lingers after it
warping   = 0;
submitted = 0;
prev      = 0;
shake     = 0;
flash_a   = 0;
hint_a    = 0;
hint_target = 1;

# ---------------- warp stars ----------------
star_src   = Image("star.png");

# Warp streaks: a star is its head (the star dot) plus a tail, a second sprite.
# The tail is tail.png stretched to each length (1 ... STREAK_LEN star sizes) and
# turned to each of ANGLES directions, once, here. Plymouth's Rotate keeps an
# image's size, so each tail is first padded to a square (a Crop larger than the
# image pads it with transparency), with its bright end at the centre, turned
# about that centre, then cropped to fit. tail[n] points its head end at
# k * 360 / ANGLES - 180 degrees (as atan2 on screen: y down), the tail behind.
tail_src = Image("tail.png");
NUM_SIZES = Math.Int((STAR_MAX - STAR_MIN) / STAR_STEP) + 1;
for (z = 0; z < NUM_SIZES; z++) {
  size = STAR_MIN + z * STAR_STEP;
  thick = Math.Int(size * TAIL_THICK + 0.5);
  if (thick < 2) { thick = 2; }
  for (l = 1; l <= STREAK_LEN; l++) {
    len = l * size;
    q = 2 * len + 2 * thick + 2;                 # the square, even
    q2 = q / 2;
    sq = tail_src.Scale(len, thick).Crop(len - q2, Math.Int(thick / 2) - q2, q, q);
    for (k = 0; k < ANGLES; k++) {
      a = k * 6.28318 / ANGLES - 3.14159;
      tx = -len * Math.Cos(a);                   # tail end, from the head
      ty = -len * Math.Sin(a);
      x0 = q2 - thick - 1;
      x1 = q2 + thick + 1;
      y0 = x0;
      y1 = x1;
      if (tx < 0) { x0 += tx; } else { x1 += tx; }
      if (ty < 0) { y0 += ty; } else { y1 += ty; }
      x0 = Math.Int(x0);
      y0 = Math.Int(y0);
      n = (z * STREAK_LEN + l - 1) * ANGLES + k;
      tail_img[n] = sq.Rotate(a).Crop(x0, y0, Math.Int(x1 - x0 + 1), Math.Int(y1 - y0 + 1));
      tail_hx[n] = q2 - x0;                      # head end, from the top-left
      tail_hy[n] = q2 - y0;
    }
  }
}

# A new star is just its head: its tail grows as it speeds up.
fun aim_star(i) {
  ang = Math.ATan2(global.star[i].y - global.cy, global.star[i].x - global.cx);
  k = Math.Int((ang + 3.14159) / 6.28318 * global.ANGLES + 0.5);
  if (k >= global.ANGLES) {
    k = 0;
  }
  back = k + global.ANGLES / 2;                 # the opposite direction
  if (back >= global.ANGLES) {
    back -= global.ANGLES;
  }
  global.star[i].k_out = k;
  global.star[i].k_in = back;
  global.star[i].len = 0;
}

fun place_star(i) {
  global.star[i].x = Math.Random() * global.W;
  global.star[i].y = Math.Random() * global.H;
  global.star[i].fade = 0;
  global.star[i].leaving = 0;
  aim_star(i);
}

# Backing off moves every star towards the centre, which empties the edges of
# the screen. Stars respawned here, on a random edge, flow in to fill them. (The
# four edges take equal shares: each one's length times its distance from the
# centre is the same, W * H / 2.)
fun place_star_at_edge(i) {
  e = Math.Int(Math.Random() * 4);
  if (e == 0) { global.star[i].x = Math.Random() * global.W; global.star[i].y = 0; }
  if (e == 1) { global.star[i].x = Math.Random() * global.W; global.star[i].y = global.H; }
  if (e == 2) { global.star[i].x = 0; global.star[i].y = Math.Random() * global.H; }
  if (e >= 3) { global.star[i].x = global.W; global.star[i].y = Math.Random() * global.H; }
  global.star[i].fade = 0;
  global.star[i].leaving = 0;
  aim_star(i);
}

for (i = 0; i < NUM_STARS; i++) {
  z = Math.Int(Math.Random() * NUM_SIZES);
  size = STAR_MIN + z * STAR_STEP;
  star[i].dot = star_src.Scale(size, size);
  star[i].z = z;
  star[i].size = size;
  star[i].half = size / 2;
  star[i].sprite = Sprite(star[i].dot);
  star[i].sprite.SetOpacity(0);
  star[i].tail = Sprite();
  star[i].tail.SetOpacity(0);
  star[i].shown = -1;                 # tail image on the tail sprite: -1 none
  star[i].k = 0;
  star[i].peak  = STAR_BRIGHT + Math.Random() * (1 - STAR_BRIGHT);
  place_star(i);
  star[i].fade = 1;
}

# ---------------- logo ----------------
logo_img = Image("logo.png");
logo_s = 1;
if (logo_img.GetWidth() > W / 3) {
  logo_s = (W / 3) / logo_img.GetWidth();
}
logo_img = logo_img.Scale(logo_img.GetWidth() * logo_s, logo_img.GetHeight() * logo_s);
logo_x = cx - logo_img.GetWidth() / 2;
logo_y = cy - logo_img.GetHeight() - 40;
logo_sprite = Sprite(logo_img);
logo_sprite.SetPosition(logo_x, logo_y, 10);

# dish centre inside the 400x400 probe logo (src/art/logo.svg): update it if the
# probe artwork changes.
dish_x = logo_x + 190 * logo_s;
dish_y = logo_y + 150 * logo_s;

# ---------------- title + hint ----------------
title_img = Image.Text("voyager", 0.85, 0.85, 0.95);
title_sprite = Sprite(title_img);
title_sprite.SetPosition(cx - title_img.GetWidth() / 2, cy, 10);

hint_img = Image.Text("type your passphrase, press enter to launch", 0.5, 0.5, 0.62);
hint_sprite = Sprite(hint_img);
hint_sprite.SetPosition(cx - hint_img.GetWidth() / 2, cy + 50, 10);
hint_sprite.SetOpacity(0);

# ---------------- signal rings (pre-scaled frames) ----------------
RING_FRAMES = 24;
ring_src = Image("ring.png");
for (k = 0; k < RING_FRAMES; k++) {
  d = 16 + k * 22;
  ring_img[k] = ring_src.Scale(d, d);
}

NUM_RINGS = 6;
for (r = 0; r < NUM_RINGS; r++) {
  ring[r].sprite = Sprite(ring_img[0]);
  ring[r].sprite.SetOpacity(0);
  ring[r].active = 0;
}
next_ring = 0;

fun spawn_ring(dir) {
  r = global.next_ring;
  global.ring[r].active = 1;
  global.ring[r].dir = dir;
  if (dir > 0) {
    global.ring[r].f = 0;
  } else {
    global.ring[r].f = global.RING_FRAMES - 1;
  }
  global.next_ring = r + 1;
  if (global.next_ring >= global.NUM_RINGS) {
    global.next_ring = 0;
  }
}

# ---------------- red flash ----------------
# the probe's red silhouette, laid over it (and shaking with it): only the probe
# flashes, so only its corner of the screen is redrawn
flash_img = Image("logo-flash.png");
flash_img = flash_img.Scale(flash_img.GetWidth() * logo_s, flash_img.GetHeight() * logo_s);
flash_sprite = Sprite(flash_img);
flash_sprite.SetPosition(logo_x, logo_y, 11);
flash_sprite.SetOpacity(0);

# ================= animation loop =================
fun refresh_callback() {
  global.t += global.DT;

  # warp speed: ramps up after Enter, otherwise decays back to still
  if (global.warping) {
    global.speed = global.speed + (global.WARP_MAX - global.speed) * 0.0334;
  } else {
    global.speed = global.speed * 0.933;
    if (Math.Abs(global.speed) < 0.005) {
      global.speed = 0;               # truly still: nothing left to redraw
    }
  }
  seen = clamp01(Math.Abs(global.speed) / global.WARP_SEEN);

  # Doppler shift: blue while speeding up, red while backing off. The envelope
  # jumps to the speed at once but fades slowly, so each shift is seen clearly.
  global.shift = global.shift * global.SHIFT_HOLD;
  if (Math.Abs(global.speed) > Math.Abs(global.shift) || global.speed * global.shift < 0) {
    global.shift = global.speed;
  }
  if (Math.Abs(global.shift) < 0.005) {
    global.shift = 0;
  }
  # in steps of 1/16: each change redraws the whole screen, so not every frame
  blue = Math.Int(clamp01(global.shift / global.BLUE_AT) * 16 + 0.5) / 16;
  red  = Math.Int(clamp01(-global.shift / global.RED_AT) * 16 + 0.5) / 16;
  global.blue_sprite.SetOpacity(blue);
  global.red_sprite.SetOpacity(red);

  # Polaris breathes, one breath every 4 s
  global.polaris_sprite.SetOpacity(0.775 + 0.225 * Math.Cos(6.2832 * global.t / 4));

  # stars. At rest they are all invisible (seen = 0): after one last pass that
  # hides them, skip the loop, the biggest cost of a frame.
  stars_idle = (global.speed == 0 && global.stars_hidden);
  global.stars_hidden = (global.speed == 0);
  for (i = 0; i < global.NUM_STARS && !stars_idle; i++) {
    dx = global.star[i].x - global.cx;
    dy = global.star[i].y - global.cy;
    global.star[i].x += dx * global.speed * global.DT;
    global.star[i].y += dy * global.speed * global.DT;
    x = global.star[i].x;
    y = global.star[i].y;
    r = Math.Sqrt((x - global.cx) * (x - global.cx) + (y - global.cy) * (y - global.cy));

    # Off screen: respawn somewhere random. Backing off packs the stars closer
    # together everywhere at once (by 2 * speed * DT of the area per frame), so
    # stars leave for the edges from everywhere, not just the core: a few each
    # frame, each fading out first. Reaching the vanish radius sends one at once.
    respawn = 0;
    if (x < -20 || x > global.W + 20 || y < -20 || y > global.H + 20) {
      place_star(i);
      respawn = 1;
    } else if (global.speed < 0) {
      if (r < global.core_vanish_r) {
        place_star_at_edge(i);
        respawn = 1;
      } else if (global.star[i].leaving) {
        global.star[i].fade -= global.LEAVE_STEP;
        if (global.star[i].fade <= 0) {
          place_star_at_edge(i);
          respawn = 1;
        }
      } else if (Math.Random() < global.INFLOW * -global.speed * global.DT) {
        global.star[i].leaving = 1;
      }
    }
    if (respawn) {
      x = global.star[i].x;
      y = global.star[i].y;
      r = Math.Sqrt((x - global.cx) * (x - global.cx) + (y - global.cy) * (y - global.cy));
    }
    # dim towards the core: gone by the time a star reaches the vanish radius
    core = clamp01((r - global.core_vanish_r) / (global.core_fade_r - global.core_vanish_r));
    if (global.star[i].leaving) {
      if (global.speed >= 0) {          # moving forward again: stay after all
        global.star[i].leaving = 0;
      }
    } else if (global.star[i].fade < 1) {
      global.star[i].fade += 0.0333;
    }

    # The tail is the star's motion blur: as long as it moves in TRAIL frames, in
    # star sizes. It eases there, so a burst shows the head first and the tail
    # after, and when typing stops the tail shrinks away before the head fades.
    want = Math.Abs(global.speed) * r * global.DT * global.TRAIL / global.star[i].size;
    if (want > global.STREAK_LEN) {
      want = global.STREAK_LEN;
    }
    global.star[i].len += (want - global.star[i].len) * global.TAIL_EASE;
    lvl = Math.Int(global.star[i].len + 0.5);
    if (global.speed > 0) {             # head leads: outward, or inward backing off
      global.star[i].k = global.star[i].k_out;
    }
    if (global.speed < 0) {
      global.star[i].k = global.star[i].k_in;
    }

    op = global.star[i].peak * seen * global.star[i].fade * core;
    global.star[i].sprite.SetPosition(x - global.star[i].half, y - global.star[i].half, 1);
    global.star[i].sprite.SetOpacity(op);
    if (lvl == 0) {
      if (global.star[i].shown != -1) {
        global.star[i].shown = -1;
        global.star[i].tail.SetOpacity(0);
      }
    } else {
      n = (global.star[i].z * global.STREAK_LEN + lvl - 1) * global.ANGLES + global.star[i].k;
      if (global.star[i].shown != n) {
        global.star[i].shown = n;
        global.star[i].tail.SetImage(global.tail_img[n]);
      }
      global.star[i].tail.SetPosition(x - global.tail_hx[n], y - global.tail_hy[n], 0);
      global.star[i].tail.SetOpacity(op);
    }
  }

  # signal rings
  for (r = 0; r < global.NUM_RINGS; r++) {
    if (global.ring[r].active) {
      f = global.ring[r].f;
      img = global.ring_img[Math.Int(f)];
      global.ring[r].sprite.SetImage(img);
      global.ring[r].sprite.SetPosition(global.dish_x - img.GetWidth() / 2, global.dish_y - img.GetHeight() / 2, 5);
      global.ring[r].sprite.SetOpacity(0.9 * (1 - f / global.RING_FRAMES));
      global.ring[r].f += 0.5 * global.ring[r].dir;
      if (global.ring[r].f >= global.RING_FRAMES || global.ring[r].f < 0) {
        global.ring[r].active = 0;
        global.ring[r].sprite.SetOpacity(0);
      }
    }
  }

  # probe shake (wrong passphrase): settles, then stops for good (and so stops
  # redrawing the probe) once under half a pixel
  if (global.shake > 0) {
    global.shake = global.shake * global.SHAKE_DECAY;
    if (global.shake < 0.5) {
      global.shake = 0;
    }
    place_probe(Math.Sin(global.t * 70) * global.shake);
  }

  # red flash (wrong passphrase), over the probe: its opacity changes in steps of
  # 1/24 (about a dozen redraws of the probe in all), not every frame
  if (global.flash_a > 0.02) {
    global.flash_a = global.flash_a * 0.933;
  } else {
    global.flash_a = 0;
  }
  global.flash_sprite.SetOpacity(Math.Int(global.flash_a * 24 + 0.5) / 24);

  # hint text fade
  # (snapped once close, so it stops redrawing)
  global.hint_a += (global.hint_target - global.hint_a) * 0.084;
  if (Math.Abs(global.hint_target - global.hint_a) < 0.01) {
    global.hint_a = global.hint_target;
  }
  global.hint_sprite.SetOpacity(global.hint_a);
}
Plymouth.SetRefreshRate(FPS);
Plymouth.SetRefreshFunction(refresh_callback);

# the probe and its red flash, ox pixels from their place
fun place_probe(ox) {
  global.logo_sprite.SetPosition(global.logo_x + ox, global.logo_y, 10);
  global.flash_sprite.SetPosition(global.logo_x + ox, global.logo_y, 11);
}

# ================= password input =================
fun display_password_callback(prompt, bullets) {
  # asked again after Enter -> passphrase was wrong
  if (global.submitted) {
    global.submitted = 0;
    global.warping = 0;
    global.speed = -1.5;
    global.flash_a = 0.6;
    global.shake = global.SHAKE_PX;
    global.prev = 0;
  }

  if (bullets != global.prev && global.shake > 0) {   # any key stops the shake
    global.shake = 0;
    place_probe(0);
  }
  if (bullets > global.prev) {          # character typed
    global.speed += global.KEY_BOOST;
    if (global.speed > 5) {
      global.speed = 5;
    }
    spawn_ring(1);
  }
  if (bullets < global.prev) {          # backspace
    global.speed -= global.BACK_PULL;
    if (global.speed < -2.5) {
      global.speed = -2.5;
    }
    spawn_ring(-1);
  }
  global.prev = bullets;

  if (bullets == 0) {
    global.hint_target = 1;
  } else {
    global.hint_target = 0;
  }
}

fun display_normal_callback() {
  # prompt closed after typing -> passphrase submitted: launch
  if (global.prev > 0) {
    global.submitted = 1;
    global.warping = 1;
    global.hint_target = 0;
  }
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
